# Copier ce fichier en .env puis remplir. Ne jamais versionner le .env (il contient le PIN).

# --- Identité ---------------------------------------------------------------
EXTRACTOR_ID=EXT-01

# --- Connexion à la base ----------------------------------------------------
# "firestore" : l'Extracteur écrit DIRECTEMENT dans Firestore (sans serveur).
# "http"      : via l'API du Balanceur (Cloud Functions ; nécessite leur déploiement).
CENTRAL_BACKEND=firestore

# -- Mode firestore (recommandé ici) : config Web du projet (fichier Firebase.js du front).
FIREBASE_PROJECT_ID=transweb-bd0a2
FIREBASE_API_KEY=AIzaSyBNi4HBIHys7-vR78Qw8rTKEpQjVSqZDnc
EXTRACTOR_OPERATORS=orange            # opérateurs servis, séparés par des virgules
OPERATION_LEASE_SEC=180

# -- Mode http (si CENTRAL_BACKEND=http) : API du Balanceur + jeton du back-office.
CENTRAL_URL=https://europe-west1-transweb-bd0a2.cloudfunctions.net/api
EXTRACTOR_TOKEN=
HTTP_TIMEOUT=15
POLL_INTERVAL=5          # secondes entre deux demandes d'opération
HEARTBEAT_INTERVAL=30    # secondes entre deux battements

# --- USSD -------------------------------------------------------------------
# termux : termux-telephony-call (code en une fois, réponse non capturée)
# http   : passerelle Android locale (menus + capture des réponses), voir docs/PROTOCOLE.md
# mock   : réponses scriptées (MOCK_USSD_SCRIPT), pour tester sans SIM
USSD_BACKEND=termux
USSD_BRIDGE_URL=http://127.0.0.1:8765
USSD_TIMEOUT=30
#USSD_SIM_SLOT=0
#MOCK_USSD_SCRIPT=tools/mock_ussd_script.json

# --- SMS --------------------------------------------------------------------
# termux : termux-sms-list ; file : fichier JSON lines (SMS_MOCK_FILE) ; none
SMS_BACKEND=termux
SMS_POLL_INTERVAL=3
SMS_WAIT_SECONDS=60      # attente des SMS de confirmation après l'USSD
SMS_LIST_LIMIT=30
LATE_SMS_GRACE=600       # un SMS arrivé jusqu'à 10 min après est rattaché à la dernière opération
# Expéditeurs suivis (vide partout = tous les SMS sont rapportés).
SMS_SENDERS=
SMS_SENDERS_ORANGE=OrangeMoney,Orange
#SMS_SENDERS_MTN=MobileMoney,MTN
#SMS_SENDERS_MOOV=MoovMoney

# --- Exploration des menus USSD (catalogue des pass) ------------------------
# Nécessite USSD_BACKEND=http (lecture des réponses). L'explorateur ne fait que LIRE :
# il ne tape jamais de PIN/montant et ne sélectionne jamais une option de confirmation.
EXPLORE_MAX_DEPTH=6
EXPLORE_MAX_NODES=60
EXPLORE_STEP_DELAY=1.0    # secondes entre deux sessions USSD (ménager l'opérateur)
# Libellés d'options jamais sélectionnés (défaut : confirmer, valider, payer, oui, retour...).
#EXPLORE_BLOCK_LABELS=confirmer,valider,payer,oui,retour,annuler

# --- Secrets locaux ---------------------------------------------------------
# Utilisés via {secret.pin} dans le code USSD. Ne transitent jamais par le réseau.
# SECRET_PIN_<OPERATEUR> a la priorité sur SECRET_PIN.
SECRET_PIN_ORANGE=
#SECRET_PIN=

# --- Divers -----------------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
LOG_TO_FILE=true
SPLASH=true              # animation de démarrage (logo MOTRANS) ; false pour la désactiver
WAKE_LOCK=true           # termux-wake-lock au démarrage
TERMUX_CMD_TIMEOUT=20
BATTERY_MIN=15
